        <mxCell id="MT8Ql6qWG2uOJ3i-PTfX-38" parent="MT8Ql6qWG2uOJ3i-PTfX-37" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontSize=16;align=left;verticalAlign=top;" value="&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Song storage:&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul class=&quot;ul1&quot; style=&quot;list-style-type: circle; color: rgb(0, 0, 0);&quot;&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿3MB × 30M songs ~ 90TB of raw audio data.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿This doesn&#39;t include replicas across different regions.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿It also doesn&#39;t include versioning overhead when artists re-upload songs.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿That&#39;s why we&#39;re looking at 2-3x this amount.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 16px; line-height: normal; font-family: Helvetica; margin: 0px; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;User metadata:&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul class=&quot;ul1&quot; style=&quot;list-style-type: circle; color: rgb(0, 0, 0);&quot;&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿User profiles, preferences, and playlist data are ~ 1KB x 500k users ~ 0.5GB.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="351" width="500" as="geometry">
            <mxRectangle height="351" width="500" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MT8Ql6qWG2uOJ3i-PTfX-39" parent="MT8Ql6qWG2uOJ3i-PTfX-37" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontSize=16;align=left;verticalAlign=top;" value="&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Song metadata:&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul class=&quot;ul1&quot; style=&quot;list-style-type: circle; color: rgb(0, 0, 0);&quot;&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿Each song needs a title, artist references, duration, file URLs, and so on.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿At roughly 100 bytes per song × 30M songs =&lt;br&gt;3GB.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿Practically nothing compared to the audio.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;p1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Daily bandwidth:&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul class=&quot;ul1&quot; style=&quot;list-style-type: circle; color: rgb(0, 0, 0);&quot;&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿The average listen time is 3.5 minutes at 128-160kbps; that&#39;s roughly 3-4MB per stream.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿Let&#39;s assume each user streams 10-15 songs daily.&lt;/font&gt;&lt;/li&gt;&lt;li class=&quot;li1&quot; style=&quot;margin: 0px; font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; line-height: normal; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;﻿﻿This leads to significant egress costs&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="351" width="500" x="500" as="geometry">
            <mxRectangle height="351" width="500" as="alternateBounds" />
          </mxGeometry>
